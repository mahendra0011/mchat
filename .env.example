# Orbit Chat Platform — Environment Baseline (Example / Non-Production Placeholders)
# DO NOT COMMIT REAL SECRETS. Copy to .env for local development.

# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
API_BASE_URL=http://localhost:4000
WS_BASE_URL=ws://localhost:4000/v1/realtime

# Database (PostgreSQL) — validated at startup when DATABASE_URL is set
# DATABASE_URL=postgres://orbit:orbit-local-dev@localhost:5432/orbit_chat
# REDIS_URL=redis://localhost:6379

# Authentication & Session Security
AUTH_JWT_SECRET=dummy-local-jwt-secret-at-least-32-chars-long
SESSION_COOKIE_SECRET=dummy-local-cookie-signing-secret-32-chars
SESSION_EXPIRY_SECONDS=604800
# Spec 07/12 — when false, an unknown x-workspace-id header is rejected with
# 403 WORKSPACE_FORBIDDEN instead of being ignored. Defaults to true in
# development and false in production.
ALLOW_WORKSPACE_FALLBACK=true
PRODUCT_NAME=Orbit Chat

# Client Configuration
VITE_API_BASE_URL=http://localhost:4000
VITE_WS_BASE_URL=ws://localhost:4000/v1/realtime

# Storage (Local / S3 Compatible)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_MAX_FILE_SIZE_BYTES=52428800

# Feature Flags & Telemetry
ENABLE_LOCAL_DEMO_FIXTURES=true
LOG_LEVEL=info
REDACT_SENSITIVE_LOGS=true
