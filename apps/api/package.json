{
  "name": "@orbit/api",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "start": "node dist/server.js",
    "dev": "node --watch dist/server.js",
    "test": "tsc -p tsconfig.tests.json && node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.1",
    "@fastify/websocket": "^10.0.1",
    "@orbit/crypto-adapter": "workspace:*",
    "@orbit/domain": "workspace:*",
    "@orbit/schemas": "workspace:*",
    "@orbit/test-fixtures": "workspace:*",
    "fastify": "^4.28.1",
    "pg": "^8.23.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "^20.14.12",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.5.10",
    "typescript": "^5.5.4"
  }
}
